#version 450
// The fast prompt for a mixture's experts in blocks of 32 or 64 (gpu.c
// experts_id): mxfp4_mmid.comp's table and tiles (64 rows by 16 vectors,
// each invocation 2 rows by 4, groups of 32 staged 4 at a time), the
// weights read as iq4nl_mmq.comp reads them, KIND as there: 0 IQ4_NL, 1
// MXFP4, 2 Q5_0 (q - 16), 3 Q2_0 (each half of a block of 64 a group,
// q - 1, the block's d), 4 NVFP4 (each half of a block of 64 a group: its
// two sub-blocks of 16, each with its UE4M3 scale, through MXFP4's table;
// sub-block s's codes in bytes 8s to 8s + 7, low nibbles its first eight
// weights, high ones the next eight); the activations in blocks of 32, each group with
// its own scale. A row may end inside a group of 256 (qwen4exp's experts'
// down matrices, 640 wide): ngroups groups of 32 a row, the stages past
// its end empty, the activations nb blocks a vector (the last group whole,
// zero past the row's end). NOT bit for bit with the CPU: rounded group by
// group.
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 128) in;
layout(constant_id = 0) const uint NV = 8; // unused: the table's constants
layout(constant_id = 1) const uint SG = 8;
layout(constant_id = 2) const uint KIND = 0;

/* bytes a group of 32 weights (Q2_0: half a block) */
const uint S = KIND == 4u ? 18u : KIND == 3u ? 9u : KIND == 2u ? 22u : KIND == 1u ? 17u : 18u;
const uint BM = 64u, BN = 16u, KS = 4u, XB = 20u;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer U4 { uvec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer U1 { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer F { float v[]; };

// t: the table, 3 uvec4 an expert: (w, x), (y, nv, ys), (unused); then
// from uvec4 tiles on, one a workgroup's z: (expert, first vector)
layout(push_constant) uniform P { uvec2 t; uint rows, nb, tiles, ngroups; } p;

struct ACache { int qs[8]; float d, d2; }; // a group: its 32 levels, its scale (NVFP4: d2 the second sub-block's)
struct BCache { int qs[8]; float d; }; // a group: quants, its d32
shared ACache sa[BM * KS];
shared BCache sb[BN * KS];

const int IQ4[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10,
                            1, 13, 25, 38, 53, 69, 89, 113);
const int MX[16] = int[16](0, 1, 2, 3, 4, 6, 8, 12, 0, -1, -2, -3, -4, -6, -8, -12);

/* the levels in the workgroup's shared memory: a constant array read at a
   varying index is far slower on some GPUs (iq4xs_matvec.comp) */
shared uint T[16];

/* each byte of w (a nibble) through the table */
uint lv(uint w)
{
    return T[w & 15u] | (T[(w >> 8) & 15u] << 8) | (T[(w >> 16) & 15u] << 16) |
           (T[(w >> 24) & 15u] << 24);
}

// word i of the 32-bit words from byte off of w
uint bword(U1 W, uint off, uint i)
{
    uint a = (off >> 2) + i, sh = 8u * (off & 3u);
    return sh != 0u ? (W.v[a] >> sh) | (W.v[a + 1u] << (32u - sh)) : W.v[a];
}

/* four bits (weights 4j..4j+3) spread to bit 4 of each byte */
uint spread5(uint b)
{
    return ((b & 1u) << 4) | ((b & 2u) << 11) | ((b & 4u) << 18) | ((b & 8u) << 25);
}

/* a byte of Q2_0 (four weights of two bits) spread to a byte each */
uint spread2(uint b)
{
    uint t = (b | (b << 12)) & 0x000f000fu;
    return (t | (t << 6)) & 0x03030303u;
}

/* c taken from each byte of v (bytes of 0 to 127, results as signed) */
uint sub_bytes(uint v, uint c)
{
    return ((v | 0x80808080u) - c) ^ 0x80808080u;
}

/* a UE4M3 byte as NVFP4's scale, times one half (quant.c
   janas_ue4m3_half): exact */
float ue4m3_half(uint x)
{
    if (x == 0u || x == 0x7fu)
        return 0.0;
    int e = int((x >> 3) & 15u), man = int(x & 7u);
    return e == 0 ? ldexp(float(man), -10) : ldexp(float(8 + man), e - 11);
}

/* the scale of the block at byte off */
float scale(U1 W, uint off)
{
    uint w = bword(W, off, 0u);
    return KIND == 1u ? uintBitsToFloat((w & 0xffu) < 2u ? 0x00200000u << (w & 0xffu)
                                                          : ((w & 0xffu) - 1u) << 23)
                      : unpackHalf2x16(w & 0xffffu).x;
}

void main()
{
    if (gl_LocalInvocationID.x < 16u)
        T[gl_LocalInvocationID.x] =
            uint(KIND == 1u || KIND == 4u ? MX[gl_LocalInvocationID.x] : IQ4[gl_LocalInvocationID.x]) & 0xffu;
    barrier();
    U4 TB = U4(p.t);
    uvec4 tl = TB.v[p.tiles + gl_WorkGroupID.z];
    uint e = tl.x;
    uvec4 t0 = TB.v[3u * e], t1 = TB.v[3u * e + 1u];
    uint nv = t1.z, ys = t1.w;
    uint r0 = gl_WorkGroupID.x * BM, v0 = tl.y;
    U4 X = U4(t0.zw);
    U1 W1 = U1(t0.xy);
    F Y = F(t1.xy);
    uint id = gl_LocalInvocationID.x;
    uint rq = (id % 32u) * 2u, vq = (id / 32u) * 4u;
    float sums[8];
    [[unroll]] for (uint i = 0; i < 8u; i++) sums[i] = 0.0;
    uint ngroups = p.ngroups;
    for (uint g0 = 0; g0 < ngroups; g0 += KS) {
        // weights: 4 invocations a row, 2 words each of the group's 8
        {
            uint iqs = id % 4u, rl = id / 4u;
            [[unroll]] for (uint l = 0; l < BM; l += 32u) {
                uint r = min(r0 + rl + l, p.rows - 1u);
                [[unroll]] for (uint k = 0; k < KS; k++) {
                    uint g = g0 + k;
                    if (g >= ngroups) { /* past the row's end: nothing */
                        [[unroll]] for (uint t = 0; t < 2u; t++)
                            sa[k * BM + rl + l].qs[2u * iqs + t] = 0;
                        if (iqs == 0u)
                            sa[k * BM + rl + l].d = sa[k * BM + rl + l].d2 = 0.0;
                        continue;
                    }
                    uint off = (r * ngroups + g) * S;
                    if (KIND == 3u) {
                        /* the block's first byte, its half's quants */
                        uint bo = off - (g % 2u) * S, qo = bo + 2u + 8u * (g % 2u);
                        uint q = bword(W1, qo, iqs / 2u);
                        [[unroll]] for (uint t = 0; t < 2u; t++) {
                            uint kw = 2u * iqs + t;
                            sa[k * BM + rl + l].qs[kw] =
                                int(sub_bytes(spread2((q >> (8u * (kw % 4u))) & 0xffu), 0x01010101u));
                        }
                        if (iqs == 0u)
                            sa[k * BM + rl + l].d = scale(W1, bo);
                        continue;
                    }
                    if (KIND == 4u) {
                        /* the block's first byte; the group's two
                           sub-blocks' codes from byte 4 + 16 (g % 2): word
                           kw of the group's 8 is sub-block kw / 4's, its
                           bytes' low nibbles (kw % 4 < 2) or high ones */
                        uint bo = off - (g % 2u) * S, qo = bo + 4u + 16u * (g % 2u);
                        [[unroll]] for (uint t = 0; t < 2u; t++) {
                            uint kw = 2u * iqs + t, j = kw % 4u;
                            uint q = bword(W1, qo, 2u * (kw / 4u) + (j & 1u));
                            sa[k * BM + rl + l].qs[kw] =
                                int(lv(j < 2u ? q & 0x0f0f0f0fu : (q >> 4) & 0x0f0f0f0fu));
                        }
                        if (iqs == 0u) {
                            uint sw = bword(W1, bo + 2u * (g % 2u), 0u);
                            sa[k * BM + rl + l].d = ue4m3_half(sw & 0xffu);
                            sa[k * BM + rl + l].d2 = ue4m3_half((sw >> 8) & 0xffu);
                        }
                        continue;
                    }
                    uint qh = KIND == 2u ? bword(W1, off + 2u, 0u) : 0u;
                    [[unroll]] for (uint t = 0; t < 2u; t++) {
                        uint kw = 2u * iqs + t, q = bword(W1, off + S - 16u, kw & 3u);
                        uint nib = kw < 4u ? q & 0x0f0f0f0fu : (q >> 4) & 0x0f0f0f0fu;
                        if (KIND == 2u)
                            nib = sub_bytes(nib | spread5((qh >> (4u * kw)) & 15u), 0x10101010u);
                        else
                            nib = lv(nib);
                        sa[k * BM + rl + l].qs[kw] = int(nib);
                    }
                    if (iqs == 0u)
                        sa[k * BM + rl + l].d = scale(W1, off);
                }
            }
        }
        // activations: 2 invocations a vector, each half a group's quants
        {
            uint k = id / 32u, c = (id % 32u) / 2u, iqs = id % 2u;
            uint v = min(v0 + c, nv - 1u);
            uint g = min(g0 + k, ngroups - 1u), b = g / 8u, j = g % 8u;
            uint xo = (v * p.nb + b) * XB;
            uvec4 q = X.v[xo + 2u * j + iqs];
            sb[k * BN + c].qs[4u * iqs] = int(q.x);
            sb[k * BN + c].qs[4u * iqs + 1u] = int(q.y);
            sb[k * BN + c].qs[4u * iqs + 2u] = int(q.z);
            sb[k * BN + c].qs[4u * iqs + 3u] = int(q.w);
            if (iqs == 0u) {
                uvec4 dq = X.v[xo + 18u + j / 4u];
                uint dw = j % 4u == 0u ? dq.x : j % 4u == 1u ? dq.y : j % 4u == 2u ? dq.z : dq.w;
                sb[k * BN + c].d = uintBitsToFloat(dw);
            }
        }
        barrier();
        for (uint k = 0; k < KS; k++) {
            ACache ca[2];
            [[unroll]] for (uint r = 0; r < 2u; r++)
                ca[r] = sa[k * BM + rq + r];
            [[unroll]] for (uint c = 0; c < 4u; c++) {
                BCache cb = sb[k * BN + vq + c];
                [[unroll]] for (uint r = 0; r < 2u; r++) {
                    if (KIND == 4u) { /* a scale a sub-block of 16 */
                        int q0 = 0, q1 = 0;
                        [[unroll]] for (uint i = 0; i < 4u; i++) {
                            q0 += dotPacked4x8EXT(ca[r].qs[i], cb.qs[i]);
                            q1 += dotPacked4x8EXT(ca[r].qs[i + 4u], cb.qs[i + 4u]);
                        }
                        sums[c * 2u + r] += cb.d * (ca[r].d * float(q0) + ca[r].d2 * float(q1));
                        continue;
                    }
                    int q = 0;
                    [[unroll]] for (uint i = 0; i < 8u; i++)
                        q += dotPacked4x8EXT(ca[r].qs[i], cb.qs[i]);
                    sums[c * 2u + r] += ca[r].d * cb.d * float(q);
                }
            }
        }
        barrier();
    }
    [[unroll]] for (uint c = 0; c < 4u; c++)
        [[unroll]] for (uint r = 0; r < 2u; r++) {
            uint row = r0 + rq + r, v = v0 + vq + c;
            if (row < p.rows && v < nv)
                Y.v[v * ys + row] = sums[c * 2u + r];
        }
}
